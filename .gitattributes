# macOS/Linux shell launchers must keep LF endings even when checked out on
# Windows (core.autocrlf=true would otherwise rewrite them to CRLF, which
# breaks the shebang line with "bad interpreter" when run on a Mac).
*.command text eol=lf
*.sh text eol=lf

# Windows launchers must have the same bytes in every clean checkout. This
# also keeps clean-release ZIP hashes independent of core.autocrlf.
*.bat text eol=crlf
*.cmd text eol=crlf

# Synthetic email-alert test fixtures are MIME messages; keep their exact bytes
# so the offline parser sees identical content in every checkout.
*.eml -text
